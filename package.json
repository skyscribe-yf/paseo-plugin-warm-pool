{
  "name": "paseo-plugin-warm-pool",
  "version": "0.1.0",
  "description": "Routes new Paseo worktree workspaces into persistent pooled slots so dependency trees are reused instead of reinstalled",
  "license": "MIT",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "git",
    "worktree"
  ],
  "files": [
    "paseo-plugin.json",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "scripts/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@getpaseo/client": "0.10.3",
    "@getpaseo/plugin": "0.10.3",
    "@getpaseo/protocol": "0.10.3",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
